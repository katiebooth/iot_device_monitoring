{
  "name": "DeviceMonitoring",
  "version": "22.0.0",
  "private": true,
  "description": "Services for IoT device platform",
  "keywords": [
    "express",
    "server",
    "typescript"
  ],
  "license": "ISC",
  "author": "Katie Booth-McKeand",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsc-watch --onSuccess \"node dist/server.js\"",
    "build": "tsc && cp -r ./src ./dist/",
    "build:ci": "tsc",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "1.20.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.19.19",
    "ts-node": "10.9.2",
    "tsc-watch": "7.2.1",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
